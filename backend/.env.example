# ==============================================================================
# PlanIt Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Gmail SMTP Configuration (Master Sender Account)
# 1. Full Gmail or Google Workspace address
GMAIL_USER=your_email@gmail.com

# 2. 16-character Google App Password (spaces will be stripped automatically)
# Generated from: https://myaccount.google.com/apppasswords
GMAIL_APP_PASS=abcd efgh ijkl mnop

# 3. Optional fallback recipient for test task notifications
NOTIFICATION_RECIPIENT=your_destination_email@gmail.com

# ==============================================================================
# Optional: AI Smart Assistant (For upcoming React feature)
# If provided, PlanIt will use Google Gemini to breakdown tasks into subtasks.
# If omitted, PlanIt uses built-in smart heuristic breakdown out-of-the-box.
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
